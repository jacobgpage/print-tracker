rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Lock all reads and writes to a single owner UID.
    // Replace REPLACE_WITH_YOUR_UID with your Firebase Authentication User UID.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "REPLACE_WITH_YOUR_UID";
    }
  }
}
